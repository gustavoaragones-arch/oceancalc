{
  "name": "oceancalc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next",
    "build": "npm run clean && next build",
    "pages:build": "npm run clean && npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "test": "npx tsx scripts/test-formula-engine.ts",
    "sitemap": "npx tsx scripts/generate-sitemap.ts",
    "generate-sitemap": "npx tsx scripts/generate-sitemap.ts",
    "ping:indexing": "node scripts/ping-indexing.mjs",
    "ping": "node scripts/ping.js",
    "refresh": "echo 'refresh trigger'",
    "validate:crawl": "node scripts/validate-crawl-depth.mjs"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "next": "15.5.2",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}